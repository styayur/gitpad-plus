+// GHSA-fc5q-39xc-vjpf: repeated bodies must not hide another variable-length
+// expression behind wrappers. Existing proven character-star flattening runs
+// before this conservative guard. Unescaped nested groups/braces and quantifiers
+// otherwise become literals, including +(@(*(a))) and nested negative extglobs.
+const hasRiskyRepeatedSyntax = branch => {
+  let escaped = false;
+  let quoted = false;
+  let bracket = false;
+  for (const ch of branch) {
+    if (escaped) { escaped = false; continue; }
+    if (ch === '\\') { escaped = true; continue; }
+    if (bracket) { if (ch === ']') bracket = false; continue; }
+    if (ch === '"') { quoted = !quoted; continue; }
+    if (quoted) continue;
+    if (ch === '[') { bracket = true; continue; }
+    if (ch === '*' || ch === '+' || ch === '(' || ch === '{') return true;
+  }
+  return bracket || quoted || escaped;
+};
