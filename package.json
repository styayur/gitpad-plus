{
  "name": "gitpad-plus",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:release": "node --test tests/release-gate.test.mjs",
    "lint": "eslint web packages plugins tests --max-warnings 0",
    "check:release": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "yjs": "13.6.33",
    "y-prosemirror": "1.3.7",
    "uuid": "14.0.3",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "remark-gfm": "4.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@types/mdast": "4.0.4",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "jsdom": "30.1.3"
  }
}
