third-party/win2d/** -text -filter whitespace=cr-at-eol
# Retain upstream/license and generated build-log whitespace verbatim.
third-party/win2d/LICENSE.txt -whitespace linguist-vendored
third-party/win2d/notices/** -whitespace linguist-vendored
third-party/win2d/build-evidence/*.log.txt -whitespace
third-party/win2d/feed/*.nupkg linguist-vendored
